# ---- Data Ingestion (Phase 1) ----
# Yellowstone gRPC 端点：Helius LaserStream / Triton / Shyft / ERPC 等
GEYSER_ENDPOINT=your-grpc-endpoint.example.com:443
GEYSER_X_TOKEN=

# ---- External Intelligence: 宏观闸门 (Phase 1) ----
BINANCE_REST_BASE=https://api.binance.com
INTEL_POLL_INTERVAL_MS=15000
INTEL_FETCH_TIMEOUT_MS=5000
INTEL_STALE_THRESHOLD_MS=60000
MACRO_GATE_ENABLED=true
# true = 情报缺失/陈旧时阻断买入（保守，推荐）；false = 降级为收紧门槛放行
INTEL_FAIL_CLOSED=true

# ---- External Intelligence: Skills Hub 旁路快照 (Phase 2) ----
# 由 agent/MCP 定时写入的 JSON 文件，BOT 只读
SKILLS_HUB_SNAPSHOT_PATH=./var/skills-hub-snapshot.json
SKILLS_HUB_POLL_INTERVAL_MS=10000
SKILLS_HUB_STALE_THRESHOLD_MS=300000

# ---- Filter Engine (Phase 2) ----
# 聚合通过分（0-100），实际门槛 = 此值 × 宏观闸门收紧倍率
FILTER_MIN_SCORE=60

# ---- Momentum / 延迟评估 (Phase 2b) ----
# 新币创建后等待该窗口再评估（等待链上动量积累）
MOMENTUM_WINDOW_MS=3000
MOMENTUM_MIN_BUYS=5
MOMENTUM_MIN_BUYERS=3
MOMENTUM_MIN_SOL_INFLOW=1
MOMENTUM_TTL_MS=1800000
SCHEDULER_MAX_PENDING=5000

# ---- Paper Trading (Phase 2b, DRY_RUN 专用) ----
PAPER_BUY_SOL=0.05
PAPER_TAKE_PROFIT_PCT=50
PAPER_STOP_LOSS_PCT=30
PAPER_MAX_HOLD_MS=600000

# ---- Lifecycle Registry (Phase 2) ----
REGISTRY_TTL_MS=1800000
REGISTRY_SWEEP_INTERVAL_MS=60000

# ---- Observability (Phase 4) ----
JOURNAL_PATH=./var/journal.jsonl
# 0 = 不启动指标端口；>0 暴露 /metrics 与 /healthz
METRICS_PORT=9090
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MIN_INTERVAL_MS=10000

# ---- 多源冗余 (Phase 4，可选) ----
GEYSER_SECONDARY_ENDPOINT=
GEYSER_SECONDARY_X_TOKEN=

# ---- RPC (Phase 3 执行层使用) ----
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
RPC_TIMEOUT_MS=4000
EXEC_MAX_RETRIES=3
EXEC_CONFIRM_TIMEOUT_MS=30000
EXEC_CIRCUIT_BREAKER_THRESHOLD=3
MAX_SLIPPAGE_BPS=1500
JITO_TIP_BASE_LAMPORTS=10000
JITO_TIP_MAX_LAMPORTS=200000
COMPUTE_UNIT_LIMIT=150000
COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=50000
LIVE_BUY_SOL=0.05

# ---- Risk Manager (Phase 3) ----
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_TRADE_SOL=0.1
RISK_DAILY_LOSS_LIMIT_SOL=1

# ---- Exit Engine (Phase 3)：光速回本 / 硬止损 / 追踪止损 ----
EXIT_RECOVERY_TARGET_PCT=100
EXIT_RECOVERY_SELL_PCT=60
EXIT_HARD_STOP_PCT=25
EXIT_TRAILING_DRAWDOWN_PCT=30
EXIT_EMERGENCY_TIP_LAMPORTS=500000

# ---- Wallet (Phase 3 才需要) ----
# base58 编码的私钥。仅通过环境变量注入，绝不写入仓库、绝不打印日志。
WALLET_SECRET_KEY=

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info
# true = 纸面模式，任何资金动作只记录不上链
DRY_RUN=true
